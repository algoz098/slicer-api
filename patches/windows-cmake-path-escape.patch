diff --git a/deps/GMP/GMP.cmake b/deps/GMP/GMP.cmake
index 623f01a171..79ed6dd8e5 100644
--- a/deps/GMP/GMP.cmake
+++ b/deps/GMP/GMP.cmake
@@ -6,15 +6,19 @@ if (IN_GIT_REPO)
 endif ()
 
 if (MSVC)
-    set(_output  ${DESTDIR}/include/gmp.h
-                 ${DESTDIR}/lib/libgmp-10.lib
-                 ${DESTDIR}/bin/libgmp-10.dll)
+    # Convert DESTDIR to CMake-style path (forward slashes) to avoid escape issues on Windows
+    # (e.g., \a in "slicer-api" being interpreted as an escape sequence)
+    file(TO_CMAKE_PATH "${DESTDIR}" _DESTDIR_CMAKE)
+
+    set(_output  "${_DESTDIR_CMAKE}/include/gmp.h"
+                 "${_DESTDIR_CMAKE}/lib/libgmp-10.lib"
+                 "${_DESTDIR_CMAKE}/bin/libgmp-10.dll")
 
     add_custom_command(
         OUTPUT  ${_output}
-        COMMAND ${CMAKE_COMMAND} -E copy ${_srcdir}/include/gmp.h ${DESTDIR}/include/
-        COMMAND ${CMAKE_COMMAND} -E copy ${_srcdir}/lib/win-${DEPS_ARCH}/libgmp-10.lib ${DESTDIR}/lib/
-        COMMAND ${CMAKE_COMMAND} -E copy ${_srcdir}/lib/win-${DEPS_ARCH}/libgmp-10.dll ${DESTDIR}/bin/
+        COMMAND ${CMAKE_COMMAND} -E copy "${_srcdir}/include/gmp.h" "${_DESTDIR_CMAKE}/include/"
+        COMMAND ${CMAKE_COMMAND} -E copy "${_srcdir}/lib/win-${DEPS_ARCH}/libgmp-10.lib" "${_DESTDIR_CMAKE}/lib/"
+        COMMAND ${CMAKE_COMMAND} -E copy "${_srcdir}/lib/win-${DEPS_ARCH}/libgmp-10.dll" "${_DESTDIR_CMAKE}/bin/"
     )
 
     add_custom_target(dep_GMP SOURCES ${_output})
